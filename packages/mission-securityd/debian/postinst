#!/bin/sh
# postinst script for mission-securityd
#
# See: https://www.debian.org/doc/debian-policy/

set -e

case "$1" in
    configure)
        # Enable systemd service on install
        if command -v deb-systemd-helper >/dev/null 2>&1; then
            deb-systemd-helper enable mission-securityd.service >/dev/null 2>&1 || true
        fi
        ;;

    triggered)
        # Handle dpkg triggers
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

# dh_installdeb will replace this with shell code automatically
# for systemd service enabling

exit 0
