# Mission OS — Konsole Profile
# Installed to /etc/xdg/konsolerc/profiles/MissionOS.profile

[Appearance]
ColorScheme=Breeze
Font=Hack,10,-1,5,50,0,0,0,0,0
Opacity=0.9

[General]
Name=Mission OS
Parent=FALLBACK/
TerminalCenter=false
TerminalColumns=120
TerminalRows=40

[Scrolling]
HistoryMode=2
HistorySize=10000
ScrollBarPosition=2

[TerminalFeatures]
BlinkingCursorEnabled=false
BidiEnabled=false
MouseWheelZoom=true
ReverseUrlColor=
UnderlineFilesEnabled=true
