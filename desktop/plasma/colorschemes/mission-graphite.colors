[Color Scheme: mission-graphite]
# Mission OS — Dark Graphite / Slate Color Scheme
#
# Design language: Dark graphite/slate foundation with restrained
# violet/cool-blue accents. Premium modern engineering aesthetic.
#
# Explicitly NOT:
#   - Kali Linux (green-terminal, dark hacker)
#   - Cyberpunk (neon, excessive glow)
#   - Gaming (RGB, saturated colors)

[General]
BackgroundColor=19,21,25
ForegroundColor=206,210,217
AlternateBackground=23,26,32
AlternateForeground=206,210,217
SelectionBackground=98,92,184
SelectionForeground=255,255,255
InactiveSelectionBackground=40,42,52
InactiveSelectionForeground=180,185,195

