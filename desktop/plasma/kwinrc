# Mission OS — KWin Window Manager Configuration
# Installed to /etc/xdg/kwinrc

[Compositing]
AnimationSpeed=1
AnimationCurve=linear
Backend=OpenGL
Enabled=true
LatencyPolicy=1
MaxFPS=60
OpenGLIsUnsafe=false
ScaleMethod=1
WindowsBlockCompositing=false

[MouseBindings]
CommandAllKey=Meta
CommandAll1=Move
CommandAll2=
CommandAll3=
CommandAllWheel=
CommandTitlebar1=Maximize
CommandTitlebar2=Lower
CommandTitlebar3=Operations
CommandWindow1=
CommandWindow2=
CommandWindow3=
Inner=Move
Right=Resize

[Plugins]
blurEnabled=false
dimadminenabled=false
dimenabled=false
krunnerintegrationenabled=true
slideenabled=true
slideanimationenabled=true
thumbnailasideenabled=true
tileseditorEnabled=true
transparencyenabled=false
wobblywindowsenabled=false

[TabBox]
DelayTime=300
HighlightWindows=true
LayoutAutoSwitchDesktop=false
LayoutName=thumbnail_grid
ListMode=CompositingOnly
ShowDesktopMode=0

[Windows]
AllowRemoteWindowActions=false
FocusPolicy=ClickToFocus
ForegroundFS=0
Placement=Smart
RollOverDesktops=false
SeparateScreenFocus=false
